<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A2E40" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#3A3F55" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_widget_gamepad"
        android:gravity="center"
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp" />
</layer-list>
